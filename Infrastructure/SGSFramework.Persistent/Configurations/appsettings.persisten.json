{
  "PersistentSettings": {
    // Database connection string and identity settings
    // Note: In production, consider using environment variables or a secure vault for sensitive information
    "DatabaseSettings": {
      "ConnectionString": "Server=localhost;Database=IoTData;User Id=sa;Password=YourPassword123!;TrustServerCertificate=True;",
      "EnableSensitiveDataLogging": true,
      "CommandTimeout": 30,
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 10,
      "UseHierarchyId": true
    },
    // Message broker settings for RabbitMQ and Kafka
    "MessageBroker": {
      "Provider": "RabbitMQ",
      "RabbitMQ": {
        "Host": "localhost",
        "VirtualHost": "/",
        "Username": "guest",
        "Password": "guest"
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "GroupId": "iot-service-group"
      }
    },
    // Identity settings for user management and authentication
    "IdentitySettings": {
      "Password": {
        "RequireDigit": true,
        "RequiredLength": 8,
        "RequireNonAlphanumeric": false
      },
      "Lockout": {
        "DefaultLockoutTimeSpan": "15",
        "MaxFailedAccessAttempts": 5
      },
      "User": {
        "RequireUniqueEmail": true
      }
    },
    // JWT settings for authentication
    "Jwt": {
      "Key": "Your_Super_Secret_Key_At_Least_32_Chars",
      "Issuer": "IoT_Service",
      "Audience": "IoT_App",
      "ExpireDays": 7
    }
  }
} 
