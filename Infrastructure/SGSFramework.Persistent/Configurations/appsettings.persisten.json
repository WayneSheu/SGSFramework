{
  "PersistentSettings": {
    // Database connection string and identity settings
    // 機密 (連線字串、帳密、金鑰) 一律由環境變數或 claudesettings.json 注入，此範本僅保留空值
    "DatabaseSettings": {
      "ConnectionString": "",
      "EnableSensitiveDataLogging": false,
      "CommandTimeout": 30,
      "MaxRetryCount": 5,
      "MaxRetryDelaySeconds": 10,
      "UseHierarchyId": true
    },
    // Message broker settings for RabbitMQ and Kafka
    "MessageBroker": {
      "Provider": "RabbitMQ",
      "RabbitMQ": {
        "Host": "localhost",
        "VirtualHost": "/",
        "Username": "",
        "Password": ""
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "GroupId": "iot-service-group"
      }
    },
    // Identity settings for user management and authentication
    "IdentitySettings": {
      "Password": {
        "RequireDigit": true,
        "RequiredLength": 8,
        "RequireNonAlphanumeric": false
      },
      "Lockout": {
        "DefaultLockoutTimeSpan": "15",
        "MaxFailedAccessAttempts": 5
      },
      "User": {
        "RequireUniqueEmail": true
      }
    },
    // JWT settings for authentication
    "Jwt": {
      "Key": "",
      "Issuer": "IoT_Service",
      "Audience": "IoT_App",
      "ExpireDays": 7
    }
  }
} 
