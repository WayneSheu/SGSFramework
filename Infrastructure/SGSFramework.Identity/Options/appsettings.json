{
  "SeedAdmin": {
    "Username": "sysadmin",
    "Email": "sysadmin@sgs.local",
    "Password": "EnvVar_Or_KeyVault_Overridden_Password_123!",
    "RoleName": "SuperAdmin",
    "EnableAutoSeed": true
  },
  "UserProvisioning": "Atomic", //建立UserProvisioning的方式，Atomic是預設值，其他值包括：Atomic, EventDriven
  //系統預設角色與權限設定
  "SystemRolePermissionSeed": {
    "Roles": [
      {
        "RoleName": "SuperAdmin",
        "RoleCode": "ROLE_SUPER_ADMIN",
        "Description": "系統管理員：僅負責系統部署、資料庫遷移與基礎設施維護，嚴禁介入業務角色指派。",
        "DefaultPermissionTypes": [ "SystemAdministrator", "GlobalInfrastructure" ],
        "AssignAll": true
      },
      {
        "RoleName": "LabManager",
        "RoleCode": "ROLE_LAB_MANAGER",
        "Description": "實驗室主管：負責管理該實驗室成員、指派角色與配置模組權限 (具備該實驗室所有管理與操作 Bitmask)。",
        "DefaultPermissionTypes": [ "LaboratoryManagement", "Administrative" ],
        "IncludeKeys": [ "ORG.*" ],
        "Categories": [ "Operational", "Administrative", "Basic" ]
      },
      {
        "RoleName": "LabOperator",
        "RoleCode": "ROLE_LAB_OPERATOR",
        "Description": "實驗室操作員：負責日常數據輸入、檢測與實驗資料維護 (具備業務模組的讀寫 Bitmask)。",
        "DefaultPermissionTypes": [ "LaboratoryOperation", "Operational" ],
        "IncludeKeys": [ "ORG.*", "PHY.*" ],
        "Categories": [ "Basic", "Operational" ],
        "ExcludeKeys": [ "ORG.LABORATORY.DELETE" ]
      },
      {
        "RoleName": "LabAuditor",
        "RoleCode": "ROLE_LAB_AUDITOR",
        "Description": "實驗室稽核員：負責檢視實驗室內所有數據與異動軌跡 (具備該實驗室所有模組的唯讀 Bitmask)。",
        "DefaultPermissionTypes": [ "LaboratoryAuditing", "ReadOnly" ],
        "IncludeKeys": [ "*.READ" ],
        "Categories": [ "Basic" ]
      }
    ]
  }
}