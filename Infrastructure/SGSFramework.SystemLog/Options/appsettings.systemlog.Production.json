{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=localhost;Initial Catalog=SGSFramework;Integrated Security=True;Encrypt=True;TrustServerCertificate=true;Connection Timeout=60;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": { //抑制微軟的內部日誌記錄
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    //"Enrich": [
    //  {
    //    "Name": "WithSensitiveDataMasking",
    //    "Args": {
    //      "maskingOptions": {
    //        "MaskString": "●●●●●●",
    //        "Properties": [ "Password", "Token", "Secret", "ID_Card" ],
    //        "Operators": [ "Serilog.Enrichers.Sensitive.SensitiveDataAttributeMaskingOperator, Serilog.Enrichers.Sensitive" ]
    //      }
    //    }
    //  }
    //],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "bufferSize": 500,
          "blockWhenFull": false,
          "configure": [
            {
              "Name": "MSSqlServer",
              "Args": {
                "connectionString": "DefaultConnection",
                "sinkOptionsSection": {
                  "tableName": "iam.Logs",

                  "autoCreateSqlTable": false,
                  "batchPostingLimit": 50,
                  "period": "00:00:05"
                },
                "columnOptionsSection": {
                  "addStandardColumns": [ "LogEvent" ],
                  "removeStandardColumns": [ "MessageTemplate" ],
                  "additionalColumns": [
                    {
                      "ColumnName": "Module",
                      "DataType": "nvarchar",
                      "DataLength": 128,
                      "AllowNull": true
                    },
                    {
                      "ColumnName": "UserId",
                      "DataType": "uniqueidentifier",
                      "DataLength": 128,
                      "AllowNull": true
                    },
                    {
                      "ColumnName": "UserName",
                      "DataType": "uniqueidentifier",
                      "DataLength": 128,
                      "AllowNull": true
                    }
                  ]
                }
              }
            }
          ]
        }
      }
    ]
  },
  "AlertSettings": {
    "IsEnabled": true,
    "CooldownSeconds": 30,
    "Smtp": {
      "Host": "smtp.office365.com",
      "Port": 587,
      "EnableSsl": true,
      "FromAddress": "SGSFramework-alert-center@company.com",
      "ToAddresSGSFramework": "architect.wayne@company.com",
      "Username": "SGSFramework-alert-center@company.com",
      "Password": "YOUR_ENCRYPTED_OR_VAULT_PASSWORD"
    }
  }
}