<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>SES.Modules.RUL</PackageId>
    <Version>1.0.0</Version>
    <Company>SES</Company>
    <Description>動態規則引擎外掛模組：規則維護（Maker-Checker 審批）、版本與試跑；引擎本體見 SGSFramework.RuleEngine</Description>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\..\MyModuleKey.snk</AssemblyOriginatorKeyFile>
    <!-- 外掛部署目錄：不依賴 $(SolutionDir)，單獨建置專案亦可正確複製 -->
    <HostPluginDir>$(MSBuildThisFileDirectory)..\..\..\Host\PhysLIMS.API\bin\$(Configuration)\net10.0\plugins\</HostPluginDir>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Infrastructure\SGSFramework.AuthTokenBucket\SGSFramework.AuthTokenBucket.csproj" />
    <ProjectReference Include="..\Module.RUL.Application\SGS.Modules.RUL.Application.csproj" />
    <ProjectReference Include="..\Module.RUL.Infrastructure\SGS.Modules.RUL.Infrastructure.csproj" />
  </ItemGroup>

  <!-- 建置後將模組主程式與附屬組件複製至 API 主專案的 plugins 目錄（由 ModuleLoader 以獨立 ALC 載入）；第三方套件不得放入 plugins -->
  <Target Name="CopyModuleDllToHost" AfterTargets="Build">
    <ItemGroup>
      <ModuleFiles Include="$(TargetDir)SGS.Modules.RUL*.dll;$(TargetDir)SGS.Modules.RUL*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(ModuleFiles)" DestinationFolder="$(HostPluginDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="powershell -Command &quot;&amp; { Set-AuthenticodeSignature -FilePath '$(TargetPath)' -Certificate (Get-ChildItem -Path Cert:\CurrentUser\My\DB22B4CE33AE64287F9392F3025EBCB7880BE213) -TimestampServer 'http://timestamp.digicert.com' }&quot;" />
  </Target>
	<Target Name="PushToBaGet" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release' And '$(BaGetApiKey)' != ''">
	<Exec Command="dotnet nuget push &quot;$(ProjectDir)bin\$(Configuration)\*.nupkg&quot; --source http://localhost:5000/v3/index.json --api-key $(BaGetApiKey) --allow-insecure-connections --skip-duplicate" />
	</Target>
</Project>
