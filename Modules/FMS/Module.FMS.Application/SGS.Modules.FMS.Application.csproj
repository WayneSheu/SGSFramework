<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)..\..\..\MyModuleKey.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Magick.NET (Apache-2.0，不需授權金鑰)：取代 SixLabors.ImageSharp（3.2 起 Release 建置須商業授權金鑰）。
      支援 JPEG / PNG / GIF（含動畫）/ WebP / BMP / TIFF 同格式重新編碼。
      外掛目錄僅部署 SGS.Modules.FMS*.dll；Magick.NET 受管與原生組件由 Host（PhysLIMS.API 參考本模組）輸出至主程式目錄。
    -->
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.2" />
  </ItemGroup>

  <ItemGroup>
    <!--
      動態浮水印（點陣化融合）：PDFtoImage（PDFium + SkiaSharp，MIT）逐頁渲染，SkiaSharp 繪製浮水印並以 SKDocument 重組 PDF。
      版本須維持 SkiaSharp 2.88 系列（與 QuestPDF 2022.12 共用同一份 SkiaSharp）；PDFtoImage 4.1.1 為最後支援 2.88 的版本。
      PDFium 原生程式庫另行指定較新版本（解析使用者上傳的 PDF，需取得安全性修正；PDFium C API 向下相容）。
    -->
    <PackageReference Include="PDFtoImage" Version="4.1.1" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="159.0.8138" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="159.0.8138" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Module.FMS.Infrastructure\SGS.Modules.FMS.Infrastructure.csproj" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="powershell -Command &quot;&amp; { Set-AuthenticodeSignature -FilePath '$(TargetPath)' -Certificate (Get-ChildItem -Path Cert:\CurrentUser\My\DB22B4CE33AE64287F9392F3025EBCB7880BE213) -TimestampServer 'http://timestamp.digicert.com' }&quot;" />
  </Target>

</Project>
