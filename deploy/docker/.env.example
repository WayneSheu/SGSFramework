# 複製為 .env 並填入實際值；.env 與 secrets\ 不得進版控、不得外傳。
HOST_PORT=8080
IMAGE_TAG=local
ASPNETCORE_ENVIRONMENT=Production

# 資料庫連線（容器內連主機 SQL Server 可用 host.docker.internal；Hyper-V 隔離下請確認可解析）
PersistentSettings__ConnectionStrings__DefaultConnection=
PersistentSettings__ConnectionStrings__MigrationConnection=
PersistentSettings__ConnectionStrings__BackupConnection=
PersistentSettings__ConnectionStrings__LogConnection=
PersistentSettings__ConnectionStrings__LogMigrationConnection=

# DataProtection 金鑰環加密用 PFX 密碼（PFX 放 .\secrets\dataprotection.pfx）
DataProtection__Certificate__PfxPassword=

# 排程（Scheduler.Enabled=true 時才需要）
Scheduler__Enabled=false
Scheduler__SystemAccount__ClientId=
Scheduler__SystemAccount__ClientSecret=
