<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <!-- 設定套件的資訊 -->
	  <PackageId>SGSFramework.ApiInfrastructure</PackageId>
	  <Version>1.0.0.1</Version>
	  <Authors>Wayne</Authors>
	  <Company>SHANDA</Company>
	  <Description>API 基礎設施</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PublishRepositoryUrl>true</PublishRepositoryUrl>
	  <EmbedUntrackedSources>true</EmbedUntrackedSources>
	  <!--關閉 OpenAPI Source Generator -->
	<EnableOpenApiSourceGenerator>false</EnableOpenApiSourceGenerator>
	<!-- 避免 Source Generator 為 XML 註解自動產生 Example 賦值碼 -->
	<OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
  </PropertyGroup>
	<ItemGroup>
   <None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<Target Name="PushToBaGet" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release'">
		<Exec Command="dotnet nuget push &quot;$(ProjectDir)bin\$(Configuration)\*.nupkg&quot; --source http://localhost:5000/v3/index.json --api-key TeamSecret2026_InitialAccess! --allow-insecure-connections --skip-duplicate" />
	</Target>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Azure.Core" Version="1.50.0" />
	  <PackageReference Include="Enterprise.HttpSdk" Version="1.0.0" />
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
	  <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
	  <PackageReference Include="SGSFramework.AuthTokenBucket" Version="1.0.0.42" />
	  <PackageReference Include="SGSFramework.CodeSecurity" Version="1.0.0" />
	  <PackageReference Include="SGSFramework.Core" Version="1.0.0.16" />
	  <PackageReference Include="SGSFramework.DataProtection" Version="1.0.0.2" />
	  <PackageReference Include="SGSFramework.Identity" Version="1.0.0.13" />
	  <PackageReference Include="SGSFramework.ModulePlugin" Version="1.0.0.18" />
	  <PackageReference Include="SGSFramework.VerifyLedger" Version="1.0.0.2" />
	</ItemGroup>
</Project>
