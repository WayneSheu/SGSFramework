<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<!-- 避免未填寫 XML 註解時跳出警告 -->
	<NoWarn>$(NoWarn);1591</NoWarn>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
	  <!-- 設定套件的資訊 -->
	  <PackageId>SGSFramework.ApiInfrastructure</PackageId>
	  <Version>1.0.0.1</Version>
	  <Authors>Wayne</Authors>
	  <Company>SHANDA</Company>
	  <Description>API 基礎設施</Description>
	  <PackageReadmeFile>README.md</PackageReadmeFile>
	  <PublishRepositoryUrl>true</PublishRepositoryUrl>
	  <EmbedUntrackedSources>true</EmbedUntrackedSources>
	  <!--關閉 OpenAPI Source Generator -->
	<EnableOpenApiSourceGenerator>false</EnableOpenApiSourceGenerator>
	<!-- 避免 Source Generator 為 XML 註解自動產生 Example 賦值碼 -->
	<OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
  </PropertyGroup>
	<ItemGroup>
   <None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
	<Target Name="PushToBaGet" AfterTargets="Pack" Condition="'$(Configuration)' == 'Release'">
		<Exec Command="dotnet nuget push &quot;$(ProjectDir)bin\$(Configuration)\*.nupkg&quot; --source http://localhost:5000/v3/index.json --api-key TeamSecret2026_InitialAccess! --allow-insecure-connections --skip-duplicate" />
	</Target>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="Azure.Core" Version="1.50.0" />
	  <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
	  <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\Infrastructure\Enterprise.HttpSdk\Enterprise.HttpSdk.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.AuditLog\SGSFramework.AuditLog.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.AuthTokenBucket\SGSFramework.AuthTokenBucket.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.CodeSecurity\SGSFramework.CodeSecurity.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.DataProtection\SGSFramework.DataProtection.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.Identity\SGSFramework.Identity.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.ModulePlugin\SGSFramework.ModulePlugin.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.Persistent\SGSFramework.Persistent.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.SystemLog\SGSFramework.SystemLog.csproj" />
	  <ProjectReference Include="..\..\Infrastructure\SGSFramework.VerifyLedger\SGSFramework.VerifyLedger.csproj" />
	  <ProjectReference Include="..\..\Shared\SGSFramework.Core\SGSFramework.Core.csproj" />
	</ItemGroup>
</Project>
