{
  "PersistentSettings": {
    // Database connection string and identity settings
    // Note: In production, consider using environment variables or a secure vault for sensitive information
    "DatabaseSettings": {
      "ConnectionString": "Data Source=D3MTG\\SQL2025;Initial Catalog=PhysLIMSDB;User Id=sa;Password=@wayne045;TrustServerCertificate=true;Connection Timeout=60;",
      "DefaultConnection": null,
      "EnableSensitiveDataLogging": true,
      "CommandTimeout": 60,
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 10,
      "UseHierarchyId": true
    },
    // Message broker settings for RabbitMQ and Kafka
    "MessageBroker": {
      "Provider": "RabbitMQ",
      "RabbitMQ": {
        "Host": "localhost",
        "VirtualHost": "/",
        "Username": "guest",
        "Password": "guest"
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "GroupId": "iot-service-group"
      }
    },
    // Identity settings for user management and authentication
    "IdentitySettings": {
      "Password": {
        "RequireDigit": true, //要求密碼中必須包含至少一個數字
        "RequiredLength": 8, //要求密碼的最小長度為?個字符
        "RequireNonAlphanumeric": true //要求密碼中必須包含至少一個非字母數字字符（例如特殊字符）
      },
      "Lockout": {
        "DefaultLockoutTimeSpan": "15", //當用戶達到最大失敗登錄嘗試次數後，鎖定用戶的時間（以分鐘為單位）
        "MaxFailedAccessAttempts": 3 //允許的最大失敗登錄嘗試次數，超過此數量後用戶將被鎖定
      },
      "User": {
        "RequireUniqueEmail": true //要求每個用戶必須有唯一的電子郵件地址，這有助於防止重複註冊和確保用戶身份的唯一性
      }
    }
  },
  "SeedAdmin": {
    "Username": "sysadmin",
    "Email": "sysadmin@sgs.local",
    "Password": "ZAQ!2wsx",
    "RoleName": "SuperAdmin",
    "EnableAutoSeed": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Verbose",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    //"Enrich": [
    //  {
    //    "Name": "WithSensitiveDataMasking",
    //    "Args": {
    //      "maskingOptions": {
    //        "MaskString": "●●●●●●",
    //        "Properties": [ "Password", "Token", "Secret", "ID_Card" ],
    //        "Operators": [ "Serilog.Enrichers.Sensitive.SensitiveDataAttributeMaskingOperator, Serilog.Enrichers.Sensitive" ]
    //      }
    //    }
    //  }
    //],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.SystemConsoleTheme::Literate, Serilog.Sinks.Console",
          "outputTemplate": "{Timestamp:HH:mm:ss} [{CorrelationId}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.json",
          "rollingInterval": "Day",
          "rollOnFileSizeLimit": true,
          "fileSizeLimitBytes": 104857600, //檔案大小限制為 100 MB
          "retainedFileCountLimit": 14, //保留 14 天的歷史記錄
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AI": {
    "Provider": "Ollama",
    "Ollama": {
      "Endpoint": "http://localhost:11434",
      "ModelId": "nomic-embed-text:latest"
    },
    "Azure": {
      "Endpoint": "https://your-resource.openai.azure.com/",
      "ApiKey": "your-api-key",
      "ModelId": "nomic-embed-text:latest" //Azure OpenAI 的嵌入模型 ID，例如 "text-embedding-3-small"
    }
  },
  "AuditSettings": {
    "IsEnabled": true, //啟用或禁用審計功能，根據需要進行設置。
    "StoreInSeparateDatabase": true, //是否將審計日誌存儲在單獨的數據庫中，這有助於提高性能和安全性。
    "RetentionYears": 3, //審計日誌的保留年限，過期的日誌將被自動刪除，以節省存儲空間。
    "AnomalyThreshold": 0.05, //異常行為的閾值，當審計日誌中出現異常行為時，將觸發警報。
    "IgnoredTables": [ "SystemLogs", "AuditLogs", "Session", "Cache", "Cache", "Temp" ], //指定不需要審計的數據表，這些表通常包含大量數據或不敏感信息。
    "ExcludedProperties": [ "PasswordHash", "SecretKey" ], //指定不需要審計的屬性，這些屬性通常包含敏感信息，不應該被記錄在審計日誌中。
    "RetentionDays": 90, //審計日誌的保留天數，過期的日誌將被自動刪除，以節省存儲空間。
    "Alerting": {
      "HighRiskTables": [ "Users", "Roles", "Permissions" ], //指定高風險表格，對這些表格的操作將觸發警報。
      "NotifyChannels": [ "Email", "Slack" ] //指定警報通知渠道，可以是電子郵件、Slack 或其他支持的通知方式。
    }
  },
  "Jwt": {
    "Secret": "YourSuperSecretKeyThatIsAtLeast32CharactersLong12345!",
    "Issuer": "PhysLIMS.API", //JWT令牌的發行者
    "Audience": "PhysLIMS.Frontend", //JWT令牌的受眾
    "AccessTokenExpirationMinutes": 15, //訪問令牌的過期時間（以分鐘為單位）
    "RefreshTokenExpirationDays": 7, //刷新令牌的過期時間（以天為單位）
    "RefreshTokenGracePeriodSeconds": 10, //刷新令牌的寬限期（以秒為單位），在此期間內即使訪問令牌過期，刷新令牌仍然有效
    "MaxDeviceCount": 7 //主動控管上限
  }
}