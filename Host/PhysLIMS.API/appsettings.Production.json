  "PersistentSettings": {
    "ConnectionStrings": {
      "DefaultConnection": "Server=D3MTG\\SQL2025;Database=PhysLIMSDB;User Id=app_sgs_user;Password=ZAQ!2wsx;TrustServerCertificate=True;Encrypt=True;",
      "MigrationConnection": "Server=D3MTG\\SQL2025;Database=PhysLIMSDB;User Id=deploy_sgs_user;Password=ZAQ!2wsx;TrustServerCertificate=True;Encrypt=True;"
    },
    "DatabaseSettings": {
      "EnableSensitiveDataLogging": false,
      "CommandTimeout": 60,
      "MaxRetryCount": 3,
      "MaxRetryDelaySeconds": 10,
      "UseHierarchyId": true
    },
    "MessageBroker": {
      "Provider": "RabbitMQ",
      "RabbitMQ": {
        "Host": "localhost",
        "VirtualHost": "/",
        "Username": "guest",
        "Password": "guest"
      },
      "Kafka": {
        "BootstrapServers": "localhost:9092",
        "GroupId": "iot-service-group"
      }
    },
    "IdentitySettings": {
      "Password": {
        "RequireDigit": true,
        "RequiredLength": 8,
        "RequireNonAlphanumeric": true
      },
      "Lockout": {
        "DefaultLockoutTimeSpan": "15",
        "MaxFailedAccessAttempts": 3
      },
      "User": {
        "RequireUniqueEmail": true
      }
    }
  },
  "SeedAdmin": {
    "Username": "sysadmin",
    "Email": "sysadmin@sgs.local",
    "Password": "ZAQ!2wsx",
    "RoleName": "SuperAdmin",
    "EnableAutoSeed": true
  },
  "UserProvisioning": {
    "StrategyType": "Atomic" // Atomic | EventDriven
  },
  "SystemRolePermissionSeed": {
    "Roles": [
      {
        "RoleName": "系統管理員",
        "RoleCode": "SA",
        "Description": "系統技術最高管理員：僅負責系統部署、資料庫遷移與基礎設施維護，嚴禁介入業務角色指派。",
        "DefaultPermissionTypes": [ "SystemAdministrator", "GlobalInfrastructure" ],
        "AssignAll": true
      },
      {
        "RoleName": "全區實驗室管理員",
        "RoleCode": "MO",
        "Description": "實驗室主管：負責管理該實驗室成員、指派角色與配置模組權限。",
        "DefaultPermissionTypes": [ "LaboratoryManagement", "Administrative" ],
        "IncludeKeys": [ "ORG.*" ],
        "Categories": [ "Operational", "Administrative", "Basic" ]
      },
      {
        "RoleName": "各區實驗室管理員",
        "RoleCode": "MA",
        "Description": "實驗室主管：負責管理該實驗室成員、指派角色與配置模組權限。",
        "DefaultPermissionTypes": [ "LaboratoryManagement", "Administrative" ],
        "IncludeKeys": [ "ORG.*" ],
        "Categories": [ "Operational", "Administrative", "Basic" ]
      },
      {
        "RoleName": "各區實驗室稽核員",
        "RoleCode": "AU",
        "Description": "實驗室稽核員：負責檢視實驗室內所有數據與異動軌跡。",
        "DefaultPermissionTypes": [ "LaboratoryAuditing", "ReadOnly" ],
        "IncludeKeys": [ "*.READ" ],
        "Categories": [ "Basic" ]
      }
    ]
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.MSSqlServer",
      "Serilog.Sinks.Async",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread",
      "Serilog.Enrichers.Process"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AlertSettings": {
    "IsEnabled": true,
    "CooldownSeconds": 30,
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "EnableSsl": true,
      "FromAddress": "your-email@gmail.com",
      "ToAddresses": "your-email@gmail.com",
      "Username": "your-email@gmail.com",
      "Password": "your-password"
    }
  },
  "AuthorizationSettings": {
    "Mode": "TwoPhase",
    "EnableCache": true,
    "CacheExpirationMinutes": 30
  },
  "AuditSettings": {
    "IsEnabled": true,
    "StoreInSeparateDatabase": true,
    "RetentionYears": 3,
    "AnomalyThreshold": 0.05,
    "IgnoredTables": [ "SystemLogs", "AuditLogs", "Session", "Cache", "Temp" ],
    "ExcludedProperties": [ "PasswordHash", "SecretKey" ],
    "RetentionDays": 90,
    "Alerting": {
      "HighRiskTables": [ "Users", "Roles", "Permissions" ],
      "NotifyChannels": [ "Email", "Slack" ]
    }
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong12345!",
    "Issuer": "PhysLIMS.API",
    "Audience": "PhysLIMS.Frontend",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "RefreshTokenGracePeriodSeconds": 10,
    "MaxDeviceCount": 7
  }
}