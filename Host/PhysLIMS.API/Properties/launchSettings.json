{
  "$schema": "https://json.schemastore.org/launchsettings.json",
  "iisSettings": {
    //原生的 Windows 驗證（Negotiate）高度依賴伺服器主機的設定。請確保 launchSettings.json 最上方的 iisSettings 已開啟 Windows 驗證：
    "windowsAuthentication": true, // 🚀 必須為 true
    "anonymousAuthentication": false // 🚀 測試 SSO 時建議先關閉匿名，強制觸發 Windows 握手
  },
  "profiles": {
    "SES.API": {
      "commandName": "Project",
      "launchBrowser": true,
      "applicationUrl": "https://localhost:5001",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "http": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "scalar/v1", // <-- 修改這裡
      "applicationUrl": "http://localhost:5216",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "https": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "scalar/v1", // <-- 修改這裡
      "applicationUrl": "https://localhost:7253;http://localhost:5216",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production"
      }
    },
    "Staging": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": true,
      "launchUrl": "scalar/v1",
      "applicationUrl": "https://localhost:7253;http://localhost:5216",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Staging"
      }
    }

  }
}
