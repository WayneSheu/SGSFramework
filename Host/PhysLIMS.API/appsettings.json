{
  "IIS": {
    "AppPoolName": "PhysLIMS.API"
  },
  "Database": {
    "AutoMigrate": true
  },
  "ModularSettings": {
    "PluginsPath": "plugins",
    "TrustedThumbprint": "DB22B4CE33AE64287F9392F3025EBCB7880BE213"
  },
  "CodeSecurity": {
    "Provider": "Windows",
    "ModulePublisher": "CN=Dev-Team-SGS",
    "SystemPublisher": "CN=SGS"
  },
  "EncryptionSettings": {
    "DefaultStrategy": "AES-256-GCM",
    "Strategies": {
      "AES-256-GCM": {
        "KeyAlias": "prod-hms-aes-key-01",
        "KeyRotationDays": 30,
        "UseHms": true
      },
      "RSA-OAEP": {
        "KeyAlias": "prod-hms-rsa-key-01",
        "KeyRotationDays": 365,
        "UseHms": true
      }
    }
  },
  "Scheduler": {
    // 排程框架 (Hangfire)：排程作業以系統帳號 (M2M) 呼叫內部 API。
    // 啟用前請先於「系統帳號管理」建立帳號並授予 Scope：database.backup、accessreview.campaign.schedule，
    // ClientSecret 以環境變數 Scheduler__SystemAccount__ClientSecret 或 claudesettings.json 注入。
    "Enabled": false,
    "ServerEnabled": true, // K8s 多節點可只在專用 Worker 開啟
    "TimeZone": "Asia/Taipei",
    "ApiBaseAddress": "", // 例：https://localhost:7253/ 或 http://physlims-api.default.svc.cluster.local/
    "SystemAccount": {
      "ClientId": "",
      "ClientSecret": "" // 機密：由環境變數或 claudesettings.json 注入
    },
    "Storage": {
      "SchemaName": "hangfire",
      "PrepareSchemaIfNecessary": true // 以 MigrationConnection 建立資料表
    },
    "Server": {
      "WorkerCount": 5,
      "Queues": [ "default" ]
    },
    "Dashboard": {
      "Enabled": false,
      "Path": "/hangfire",
      "LocalRequestsOnly": true,
      "ReadOnly": true
    },
    // 作業啟用與預設週期；排程管理頁可再自訂週期 / 暫停（優先於此設定，存於 core.ScheduledJobSettings）
    "Jobs": {
      "database-backup-full": { "Enabled": true, "Cron": "0 2 * * *" },
      "database-backup-differential": { "Enabled": false, "Cron": "0 13 * * *" },
      "access-review-campaign": { "Enabled": true, "Cron": "0 8 1 1,4,7,10 *" },
      "log-cleanup": { "Enabled": true, "Cron": "30 3 * * *" }
    },
    "DatabaseBackup": {
      "Directory": "", // SQL Server 主機上的目錄或 UNC；空白 = 執行個體預設備份目錄
      "CopyOnly": false,
      "Compression": false, // SQL Server Express 不支援
      "Checksum": true,
      "Verify": true,
      "RetentionDays": 0, // > 0 時清除本系統產生的過期備份檔（需應用程式主機可存取該目錄）
      "CommandTimeoutSeconds": 3600
    },
    "LogCleanup": {
      // 各項 0 = 不清除。SystemLogs / SecurityLog / AuditLogs 為僅附加 Ledger 資料表，資料庫禁止刪除
      "OutboxProcessedRetentionDays": 30,
      "OutboxDeadLetterRetentionDays": 90,
      "ScheduledJobRunRetentionDays": 180,
      "AuditTrailRetentionDays": 0, // 角色 / 系統帳號 / 系統配置 / 功能狀態異動紀錄，屬稽核證據；啟用時至少 365 天
      "BatchSize": 5000
    },
    "AccessReview": {
      "NamePrefix": "定期權限覆核",
      "Period": "Quarter", // Month | Quarter | HalfYear | Year，應與 Cron 頻率一致
      "DueInDays": 14,
      "RoleIds": [],
      "CloseOverdueCampaigns": false
    }
  },
  "HmsSettings": {
    "SharedSecret": "", // 機密：由環境變數 HmsSettings__SharedSecret 或 claudesettings.json 注入

    "BaseUrl": "http://localhost:5216" // 指向您的本地 Mock Server 或模擬環境
  }
}
