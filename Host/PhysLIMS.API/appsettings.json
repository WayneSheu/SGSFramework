{
  "IIS": {
    "AppPoolName": "PhysLIMS.API"
  },
  "Database": {
    "AutoMigrate": true
  },
  "ModularSettings": {
    "PluginsPath": "plugins",
    "TrustedThumbprint": "DB22B4CE33AE64287F9392F3025EBCB7880BE213",
    // 上傳模組後自動重新啟動 API（外掛的 DI 註冊與資料庫遷移只在啟動時執行；IIS 會自動拉起）
    "RestartAfterUpload": true,
    "RestartDelaySeconds": 3
  },
  "CodeSecurity": {
    "Provider": "Windows",
    "ModulePublisher": "CN=Dev-Team-SGS",
    "SystemPublisher": "CN=SGS"
  },
  "EncryptionSettings": {
    "DefaultStrategy": "AES-256-GCM",
    "Strategies": {
      "AES-256-GCM": {
        "KeyAlias": "prod-hms-aes-key-01",
        "KeyRotationDays": 30,
        "UseHms": true
      },
      "RSA-OAEP": {
        "KeyAlias": "prod-hms-rsa-key-01",
        "KeyRotationDays": 365,
        "UseHms": true
      }
    }
  },
  // 日誌庫冷熱分層：熱庫 = PersistentSettings:ConnectionStrings:LogConnection 指定的資料庫（可寫、現行）；
  // 年度換庫後的歷史庫登記於此（唯讀冷庫，僅供查閱；連線沿用 LogConnection、僅替換資料庫名稱，不另存密碼）。
  // 換庫流程見 docs/sql/20261110_log_yearly_rotation.sql。範例：
  //   "Databases": [ { "Key": "2026", "Database": "PhysLIMSLogDB_2026", "DisplayName": "冷資料 2026" } ]
  // 順序由舊到新；環境變數覆寫：LogArchive__Databases__0__Key / __Database / __DisplayName
  // 冷庫另會自動偵測：同一伺服器上名為 {熱庫}_{4 位數年度} 且 READ_ONLY 的資料庫（AutoDiscover，預設 true），年度換庫後不需改設定。
  "LogArchive": {
    "AutoDiscover": true,
    "Databases": []
  },
  // 日誌庫年度換庫（半自動，見 docs/sql/20261110_grant_log_rotation_account.sql）：連線 PersistentSettings:ConnectionStrings:RotationConnection 以環境變數注入。
  // BackupDirectory 為 SQL Server「主機」上的目錄（SQL Server 服務帳號需可寫入）；空白 = 使用執行個體預設備份目錄。
  "LogRotation": {
    "BackupDirectory": "",
    "Granularity": "Year", // Year = 整年度（冷庫 _2026）；HalfYear = 半年度（_2026H1 / _2026H2）。影響建議期間；手動準備可任選年度 / 上 / 下半年
    "CommandTimeoutSeconds": 3600
  },
  "Scheduler": {
    // 排程框架 (Hangfire)：排程作業以系統帳號 (M2M) 呼叫內部 API。
    // 啟用前請先於「系統帳號管理」建立帳號並授予 Scope：database.backup、accessreview.campaign.schedule，
    // ClientSecret 以環境變數 Scheduler__SystemAccount__ClientSecret 或 claudesettings.json 注入。
    "Enabled": false,
    "ServerEnabled": true, // K8s 多節點可只在專用 Worker 開啟
    "TimeZone": "Asia/Taipei",
    "ApiBaseAddress": "", // 例：https://localhost:7253/ 或 http://physlims-api.default.svc.cluster.local/
    "SystemAccount": {
      "ClientId": "",
      "ClientSecret": "" // 機密：由環境變數或 claudesettings.json 注入
    },
    "Storage": {
      "SchemaName": "hangfire",
      "PrepareSchemaIfNecessary": true // 以 MigrationConnection 建立資料表
    },
    "Server": {
      "WorkerCount": 5,
      "Queues": [ "default" ]
    },
    "Dashboard": {
      "Enabled": false,
      "Path": "/hangfire",
      "LocalRequestsOnly": true,
      "ReadOnly": true
    },
    // 作業啟用與預設週期；排程管理頁可再自訂週期 / 暫停（優先於此設定，存於 core.ScheduledJobSettings）
    "Jobs": {
      "database-backup-full": { "Enabled": true, "Cron": "0 2 * * *" },
      "database-backup-differential": { "Enabled": false, "Cron": "0 13 * * *" },
      "access-review-campaign": { "Enabled": true, "Cron": "0 8 1 1,4,7,10 *" },
      "log-cleanup": { "Enabled": true, "Cron": "30 3 * * *" }
    },
    "DatabaseBackup": {
      "Directory": "", // SQL Server 主機上的目錄或 UNC；空白 = 執行個體預設備份目錄
      "CopyOnly": false,
      "Compression": false, // SQL Server Express 不支援
      "Checksum": true,
      "Verify": true,
      "RetentionDays": 0, // > 0 時清除本系統產生的過期備份檔（需應用程式主機可存取該目錄）
      "CommandTimeoutSeconds": 3600
    },
    "LogCleanup": {
      // 各項 0 = 不清除。SystemLogs / SecurityLog / AuditLogs 為僅附加 Ledger 資料表，資料庫禁止刪除
      "OutboxProcessedRetentionDays": 30,
      "OutboxDeadLetterRetentionDays": 90,
      "ScheduledJobRunRetentionDays": 180,
      "AuditTrailRetentionDays": 0, // 角色 / 系統帳號 / 系統配置 / 功能狀態異動紀錄，屬稽核證據；啟用時至少 365 天
      "BatchSize": 5000
    },
    "AccessReview": {
      "NamePrefix": "定期權限覆核",
      "Period": "Quarter", // Month | Quarter | HalfYear | Year，應與 Cron 頻率一致
      "DueInDays": 14,
      "RoleIds": [],
      "CloseOverdueCampaigns": false
    }
  },
  "Calendar": {
    // 行事曆管理（外掛模組 SGS.Modules.CAL）是否已部署：true 時 Scheduler 會註冊「政府辦公日曆每月同步」（cal-holiday-sync）與
    // 「活動提醒派送」（cal-event-reminders，每 5 分鐘）。排程帳號須在系統帳號管理授與 scope：cal.holiday.sync、cal.reminders.dispatch。
    "Enabled": false,
    "GovSync": {
      // 政府行政機關辦公日曆（行政院人事行政總處）來源網址樣板（須為 https）：{year} 西元年、{rocYear} 民國年。
      // 預設為 TaiwanCalendar 專案（官方辦公日曆轉出的 JSON，jsDelivr CDN）；也可改用官方開放資料 CSV（欄位：西元日期,星期,是否放假(0上班/2放假),備註）。
      // 伺服器必須能連到該網址；網路受限時可改用「假日與補班 > 批次匯入」貼上官方 CSV。
      "UrlTemplate": "https://cdn.jsdelivr.net/gh/ruyut/TaiwanCalendar/data/{year}.json"
    }
  },
  "Manual": {
    // 操作手冊管理（外掛模組 SGS.Modules.MAN）的 AI 生成（本機 Ollama）是否啟用；預設關閉，僅開發或內網環境啟用。人工維護手冊主題不受影響。
    // 環境變數覆寫：Manual__Enabled=true
    "Enabled": true,
    // Ollama 位址：僅允許本機或內網位址（loopback／私有網段／單一標籤主機名），截圖與規格資料不得送往外部服務
    "OllamaBaseUrl": "http://localhost:11434",
    "VisionModel": "qwen3-vl:8b",
    "TextModel": "qwen2.5:14b",
    "TimeoutMinutes": 10,
    // 模型 context 長度（token）。thinking 版視覺模型的思考內容也計入，過小會讓正文為空；越大越吃記憶體
    "NumCtx": 16384,
    // 單次輸出 token 上限（含思考內容）；正常約 1,500，思考失控時在此截斷並重試，避免卡滿逾時時間
    "MaxOutputTokens": 4096,
    // 模型輸出為空或無法解析時的最大嘗試次數（逾時與連線錯誤不重試）
    "MaxAttempts": 2,
    "MaxImageBytes": 8388608,
    "QueueCapacity": 20,
    // 後端規格上下文（選填）：建議指向精簡的 user-manual 文件，例如 https://localhost:7253/openapi/user-manual.json；空白＝僅依截圖生成
    "OpenApiUrl": ""
  },
  "Meeting": {
    // 會議助理（外掛模組 SGS.Modules.MTG）的 AI 紀要（本機 Ollama Map-Reduce）是否啟用；預設關閉。會議與逐字稿維護不受影響。
    // 環境變數覆寫：Meeting__Enabled=true
    "Enabled": false,
    // Ollama 位址：僅允許本機或內網位址（loopback／私有網段／單一標籤主機名），逐字稿不得送往外部服務
    "OllamaBaseUrl": "http://localhost:11434",
    "TextModel": "qwen3:14b",
    // 文字模型服務：Ollama（預設）或 OpenAI（OpenAI 相容的 /v1/chat/completions：LM Studio、vLLM、llama.cpp server…）。
    // 改用 LM Studio：Provider=OpenAI、OpenAiBaseUrl=http://localhost:1234/v1、TextModel=LM Studio 顯示的模型識別（例：qwen/qwen3-14b）。
    // OpenAI 介面無法由呼叫端指定 NumCtx，請在 LM Studio 載入模型時把 Context Length 設到至少 8192。
    // 若服務需要金鑰，請用環境變數 Meeting__OpenAiApiKey（不要寫進設定檔）；LM Studio 本機預設不需要。
    "Provider": "Ollama",
    "OpenAiBaseUrl": "http://localhost:1234/v1",
    // OpenAI 相容服務：要求模型不輸出思考過程（提示尾端加 /no_think，Qwen3 系列支援）。實測 LM Studio 的 qwen3-14b 開思考會讓同一題慢約 3 倍，
    // 且思考 token 會佔用 MaxOutputTokens；使用不支援此開關的模型時請設為 false。
    "DisableReasoning": true,
    "TimeoutMinutes": 10,
    // 模型 context 長度（token）；6144 搭配 ChunkChars 4500 以控制共享記憶體用量
    "NumCtx": 6144,
    "MaxOutputTokens": 2048,
    // 逐字稿切塊字元上限與相鄰切塊重疊字元數
    "ChunkChars": 4500,
    "OverlapChars": 300,
    "MaxTranscriptChars": 2000000,
    "QueueCapacity": 10,
    // 會議錄音保存天數：已轉錄（或轉錄失敗）超過此天數的錄音由排程從檔案管理刪除，逐字稿與紀要保留。0 = 不自動刪除。
    // 大於 0 時 Scheduler 才會註冊「MTG 過期錄音清除」（mtg-audio-retention，每日 04:30）；排程帳號須在系統帳號管理授與 scope：mtg.audio.purge。
    "AudioRetentionDays": 0,
    // 語音轉錄服務（OpenAI 相容協定 POST /v1/audio/transcriptions；whisper.cpp server、faster-whisper-server 等皆可）。
    // 預設關閉：關閉時仍可貼上逐字稿，但不能上傳音檔。位址只允許本機或內網，音檔不得送往外部服務。
    // 環境變數覆寫：Meeting__Whisper__Enabled=true、Meeting__Whisper__BaseUrl=http://主機:8080
    "Whisper": {
      "Enabled": false,
      "BaseUrl": "http://localhost:8080",
      "Path": "/v1/audio/transcriptions",
      "Model": "whisper-1", // whisper.cpp 會忽略此欄位；faster-whisper-server 等需填實際模型名稱
      "Language": "zh", // 空白＝自動偵測；中英夾雜的會議建議指定 zh
      "TimeoutMinutes": 180, // 實測純 CPU 約為音檔長度的 1.4 倍；請設為預期最長音檔的 2 倍以上
      "MaxAudioBytes": 104857600, // 轉錄時整檔讀入記憶體（不落地），須 ≤ FMS 分類 meeting-audio 的上限
      "QueueCapacity": 10
    }
  },
  "ProjectManagement": {
    // 專案管理（外掛模組 SGS.Modules.PMS）是否已部署：true 時排程註冊「PMS CR 評估逾期提醒」（pms-cr-eval-watch）
    "Enabled": false
  },
  "Quotation": {
    // 報價管理（外掛模組 SGS.Modules.QTN）是否已部署：true 時 Scheduler 註冊「報價到期掃描」（qtn-quote-expiry）、
    // 「CR 評估逾期提醒」（qtn-cr-overdue）與「結案復盤逾期提醒」（qtn-variance-due）。
    // 排程帳號須在系統帳號管理授與 scope：qtn.quote.scan、qtn.cr.scan、qtn.review.scan。
    "Enabled": false
  },
  "FileManagement": {
    // 檔案管理（外掛模組 SGS.Modules.FMS 讀取本區段；未部署該模組時 IFileManagementService 一律回應 503）。
    // 無狀態安全儲存：Web / API 節點不保存任何實體檔案或暫存檔（上傳、加解密、縮圖、浮水印全程記憶體串流處理），
    // 檔案一律寫入下列儲存體並以 AES-256-GCM 信封加密（資料金鑰由 Data Protection 金鑰環包裝，金鑰環遺失即無法解密）。
    // Enabled = true 時 Scheduler 會註冊 file-purge 清除排程，須同時部署 FMS 模組。
    // 驅動切換只需變更 Targets:{Target}:Provider：FileSystem（地端 NAS / UNC）、S3（MinIO / AWS S3）、AzureBlob（Azure / Azurite）。
    // 機密（S3 SecretKey、Azure 連線字串）與路徑請以環境變數注入，例：
    //   FileManagement__Enabled=true
    //   FileManagement__Targets__LocalPrivate__RootPath=\\nas01\physlims-private
    //   FileManagement__Targets__LocalPrivate__Provider=S3、FileManagement__Targets__LocalPrivate__S3__SecretKey=...
    // NAS 共享資料夾須於作業系統 / IIS 層級關閉「執行」權限，僅授予應用程式集區帳號讀寫。
    "Enabled": true,
    "DefaultCategory": "General",
    "MaxFileSizeBytes": 104857600, // 全域單檔上限 100MB
    "StreamBufferSize": 65536, // 64KB 串流緩衝（< 85KB，不進 LOH）
    "Upload": {
      "MaxInMemoryBufferBytes": 52428800, // 需完整內容驗證的格式（圖片重新編碼、OOXML）記憶體緩衝上限 50MB；其餘格式串流處理
      "MaxConcurrentBufferedUploads": 8, // 同時記憶體緩衝的上傳數上限（超過排隊）
      "EncryptionChunkSize": 65536 // 加密分塊大小（Range 讀取粒度）
    },
    "Targets": {
      "LocalPrivate": {
        "Provider": "FileSystem",
        "RootPath": "",
        "DefaultContainer": "private",
        "S3": { "ServiceUrl": "", "Region": "us-east-1", "AccessKey": "", "SecretKey": "", "ForcePathStyle": true, "AutoCreateBucket": false, "PartSizeMb": 8 },
        "AzureBlob": { "ConnectionString": "", "AutoCreateContainer": false }
      },
      "CloudPublic": {
        "Provider": "FileSystem",
        "RootPath": "",
        "DefaultContainer": "public",
        "S3": { "ServiceUrl": "", "Region": "us-east-1", "AccessKey": "", "SecretKey": "", "ForcePathStyle": true, "AutoCreateBucket": false, "PartSizeMb": 8 },
        "AzureBlob": { "ConnectionString": "", "AutoCreateContainer": false }
      }
    },
    // 業務分流：分類決定儲存目標、允許副檔名、大小上限、是否加密與是否僅供檢視（用戶端無法自行指定）
    "Categories": {
      "General": { "Target": "LocalPrivate" },
      // 正式報告 PDF（RPT 模組）：地端機密、僅 PDF、加密儲存，禁止經通用 api/v1/files 存取（須經報告授權）
      "Report": {
        "Target": "LocalPrivate",
        "Container": "reports",
        "AllowedExtensions": [ ".pdf" ],
        "MaxFileSizeBytes": 52428800,
        "AllowGenericApi": false, // false = 不允許經通用端點 api/v1/files 存取
        "Encrypt": true,
        "CacheMaxAgeSeconds": 0 // 不快取
      },
      // 專案管理（PMS 模組）附件：地端機密、加密儲存，禁止經通用 api/v1/files 存取（須經專案成員資料列授權後由 PMS 轉發）
      // 交付物：僅允許 FMS 簽章檢查支援的格式（Office、PDF、圖片、txt／csv）；單檔 50MB；僅經 PMS 授權後存取
      "pms-deliverable": {
        "Target": "LocalPrivate",
        "Container": "pms-deliverables",
        "AllowedExtensions": [ ".pdf", ".docx", ".xlsx", ".pptx", ".doc", ".xls", ".ppt", ".png", ".jpg", ".jpeg", ".gif", ".txt", ".csv" ],
        "MaxFileSizeBytes": 52428800,
        "AllowGenericApi": false,
        "Encrypt": true,
        "CacheMaxAgeSeconds": 0
      },
      // 問題單附件（截圖、Log）：僅 FMS 簽章檢查支援的格式；單檔 20MB；僅經 PMS 授權後存取
      "pms-issue": {
        "Target": "LocalPrivate",
        "Container": "pms-issues",
        "AllowedExtensions": [ ".png", ".jpg", ".jpeg", ".gif", ".pdf", ".txt", ".csv", ".docx", ".xlsx", ".doc", ".xls" ],
        "MaxFileSizeBytes": 20971520,
        "AllowGenericApi": false,
        "Encrypt": true,
        "CacheMaxAgeSeconds": 0
      },
      "pms-form": { "Target": "LocalPrivate", "Container": "pms-forms", "AllowedExtensions": [ ".pdf" ], "MaxFileSizeBytes": 20971520, "AllowGenericApi": false, "Encrypt": true, "CacheMaxAgeSeconds": 0 },
      // 專案合約附件（甲方草稿、用印正本）：加密、非通用 API，只經 PMS 合約成員授權後存取
      "pms-contract": { "Target": "LocalPrivate", "Container": "pms-contracts", "AllowedExtensions": [ ".pdf", ".docx", ".doc" ], "MaxFileSizeBytes": 20971520, "AllowGenericApi": false, "Encrypt": true, "CacheMaxAgeSeconds": 0 },
      // 報價附件（QTN）：需求資料、折扣說明書、客戶簽回文件；僅經報價模組授權存取
      "qtn-quotation": { "Target": "LocalPrivate", "Container": "qtn-quotations", "AllowedExtensions": [ ".pdf", ".docx", ".doc", ".xlsx", ".xls", ".png", ".jpg", ".jpeg" ], "MaxFileSizeBytes": 20971520, "AllowGenericApi": false, "Encrypt": true, "CacheMaxAgeSeconds": 0 },
      // 會議錄音（MTG 會議助理）：地端機密、加密儲存、非通用 API，只經 MTG 模組授權後存取；僅開放音訊容器格式（FMS 驗證檔頭簽章）
      "meeting-audio": {
        "Target": "LocalPrivate",
        "Container": "meeting-audio",
        "AllowedExtensions": [ ".wav", ".mp3", ".m4a", ".mp4", ".ogg", ".oga", ".flac", ".webm" ],
        "MaxFileSizeBytes": 104857600,
        "AllowGenericApi": false,
        "Encrypt": true,
        "CacheMaxAgeSeconds": 0
      },
      // 公開圖片：不加密才能以預簽名網址 / CDN 直連（物件儲存驅動時）
      "Image": {
        "Target": "CloudPublic",
        "Container": "images",
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ],
        "MaxFileSizeBytes": 20971520,
        "Encrypt": false,
        "CacheMaxAgeSeconds": 31536000
      }
    },
    "Image": {
      "ReencodeOnUpload": true, // 二次解碼重新編碼：洗除 Polyglot 夾帶代碼與 EXIF / GPS
      "MaxDimension": 12000,
      "MaxPixels": 80000000,
      "MaxFrames": 200,
      "JpegQuality": 85,
      "AllowedSizes": [ "64x64", "128x128", "256x256", "512x512", "1024x1024", "256x0", "512x0", "1024x0" ] // 縮圖尺寸白名單（防 DoS）
    },
    "ThumbnailCache": {
      "Enabled": true, // 各節點記憶體快取（不寫入本機磁碟）
      "MaxMemoryBytes": 268435456, // 256MB
      "SlidingExpirationMinutes": 60
    },
    "Watermark": {
      "Dpi": 120, // PDF 逐頁點陣化解析度
      "MaxPages": 50, // 單次線上檢視最多頁數（防 DoS）
      "Opacity": 80, // 浮水印不透明度（0~255）；深色陰影 + 淺色本體雙色疊印
      "JpegQuality": 80,
      "FontPath": "" // 空白時使用系統字型（Noto Sans TC → 微軟正黑體）
    },
    "Purge": {
      "RetentionDays": 30, // 虛擬刪除後保留天數，期滿由排程 file-purge 清除實體檔案
      "BatchSize": 200,
      "MaxBatchesPerRun": 50
    }
  },
  "HmsSettings": {
    "SharedSecret": "", // 機密：由環境變數 HmsSettings__SharedSecret 或 claudesettings.json 注入

    "BaseUrl": "http://localhost:5216" // 指向您的本地 Mock Server 或模擬環境
  }
}
