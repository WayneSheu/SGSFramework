{
  "IIS": {
    "AppPoolName": "PhysLIMS.API"
  },
  "Database": {
    "AutoMigrate": true
  },
  "ModularSettings": {
    "PluginsPath": "plugins",
    "TrustedThumbprint": "DB22B4CE33AE64287F9392F3025EBCB7880BE213",
    // 上傳模組後自動重新啟動 API（外掛的 DI 註冊與資料庫遷移只在啟動時執行；IIS 會自動拉起）
    "RestartAfterUpload": true,
    "RestartDelaySeconds": 3
  },
  "CodeSecurity": {
    "Provider": "Windows",
    "ModulePublisher": "CN=Dev-Team-SGS",
    "SystemPublisher": "CN=SGS"
  },
  "EncryptionSettings": {
    "DefaultStrategy": "AES-256-GCM",
    "Strategies": {
      "AES-256-GCM": {
        "KeyAlias": "prod-hms-aes-key-01",
        "KeyRotationDays": 30,
        "UseHms": true
      },
      "RSA-OAEP": {
        "KeyAlias": "prod-hms-rsa-key-01",
        "KeyRotationDays": 365,
        "UseHms": true
      }
    }
  },
  "Scheduler": {
    // 排程框架 (Hangfire)：排程作業以系統帳號 (M2M) 呼叫內部 API。
    // 啟用前請先於「系統帳號管理」建立帳號並授予 Scope：database.backup、accessreview.campaign.schedule，
    // ClientSecret 以環境變數 Scheduler__SystemAccount__ClientSecret 或 claudesettings.json 注入。
    "Enabled": false,
    "ServerEnabled": true, // K8s 多節點可只在專用 Worker 開啟
    "TimeZone": "Asia/Taipei",
    "ApiBaseAddress": "", // 例：https://localhost:7253/ 或 http://physlims-api.default.svc.cluster.local/
    "SystemAccount": {
      "ClientId": "",
      "ClientSecret": "" // 機密：由環境變數或 claudesettings.json 注入
    },
    "Storage": {
      "SchemaName": "hangfire",
      "PrepareSchemaIfNecessary": true // 以 MigrationConnection 建立資料表
    },
    "Server": {
      "WorkerCount": 5,
      "Queues": [ "default" ]
    },
    "Dashboard": {
      "Enabled": false,
      "Path": "/hangfire",
      "LocalRequestsOnly": true,
      "ReadOnly": true
    },
    // 作業啟用與預設週期；排程管理頁可再自訂週期 / 暫停（優先於此設定，存於 core.ScheduledJobSettings）
    "Jobs": {
      "database-backup-full": { "Enabled": true, "Cron": "0 2 * * *" },
      "database-backup-differential": { "Enabled": false, "Cron": "0 13 * * *" },
      "access-review-campaign": { "Enabled": true, "Cron": "0 8 1 1,4,7,10 *" },
      "log-cleanup": { "Enabled": true, "Cron": "30 3 * * *" }
    },
    "DatabaseBackup": {
      "Directory": "", // SQL Server 主機上的目錄或 UNC；空白 = 執行個體預設備份目錄
      "CopyOnly": false,
      "Compression": false, // SQL Server Express 不支援
      "Checksum": true,
      "Verify": true,
      "RetentionDays": 0, // > 0 時清除本系統產生的過期備份檔（需應用程式主機可存取該目錄）
      "CommandTimeoutSeconds": 3600
    },
    "LogCleanup": {
      // 各項 0 = 不清除。SystemLogs / SecurityLog / AuditLogs 為僅附加 Ledger 資料表，資料庫禁止刪除
      "OutboxProcessedRetentionDays": 30,
      "OutboxDeadLetterRetentionDays": 90,
      "ScheduledJobRunRetentionDays": 180,
      "AuditTrailRetentionDays": 0, // 角色 / 系統帳號 / 系統配置 / 功能狀態異動紀錄，屬稽核證據；啟用時至少 365 天
      "BatchSize": 5000
    },
    "AccessReview": {
      "NamePrefix": "定期權限覆核",
      "Period": "Quarter", // Month | Quarter | HalfYear | Year，應與 Cron 頻率一致
      "DueInDays": 14,
      "RoleIds": [],
      "CloseOverdueCampaigns": false
    }
  },
  "FileManagement": {
    // 檔案管理（外掛模組 SGS.Modules.FMS 讀取本區段；未部署該模組時 IFileManagementService 一律回應 503）。
    // 無狀態安全儲存：Web / API 節點不保存任何實體檔案或暫存檔（上傳、加解密、縮圖、浮水印全程記憶體串流處理），
    // 檔案一律寫入下列儲存體並以 AES-256-GCM 信封加密（資料金鑰由 Data Protection 金鑰環包裝，金鑰環遺失即無法解密）。
    // Enabled = true 時 Scheduler 會註冊 file-purge 清除排程，須同時部署 FMS 模組。
    // 驅動切換只需變更 Targets:{Target}:Provider：FileSystem（地端 NAS / UNC）、S3（MinIO / AWS S3）、AzureBlob（Azure / Azurite）。
    // 機密（S3 SecretKey、Azure 連線字串）與路徑請以環境變數注入，例：
    //   FileManagement__Enabled=true
    //   FileManagement__Targets__LocalPrivate__RootPath=\\nas01\physlims-private
    //   FileManagement__Targets__LocalPrivate__Provider=S3、FileManagement__Targets__LocalPrivate__S3__SecretKey=...
    // NAS 共享資料夾須於作業系統 / IIS 層級關閉「執行」權限，僅授予應用程式集區帳號讀寫。
    "Enabled": false,
    "DefaultCategory": "General",
    "MaxFileSizeBytes": 104857600, // 全域單檔上限 100MB
    "StreamBufferSize": 65536, // 64KB 串流緩衝（< 85KB，不進 LOH）
    "Upload": {
      "MaxInMemoryBufferBytes": 52428800, // 需完整內容驗證的格式（圖片重新編碼、OOXML）記憶體緩衝上限 50MB；其餘格式串流處理
      "MaxConcurrentBufferedUploads": 8, // 同時記憶體緩衝的上傳數上限（超過排隊）
      "EncryptionChunkSize": 65536 // 加密分塊大小（Range 讀取粒度）
    },
    "Targets": {
      "LocalPrivate": {
        "Provider": "FileSystem",
        "RootPath": "",
        "DefaultContainer": "private",
        "S3": { "ServiceUrl": "", "Region": "us-east-1", "AccessKey": "", "SecretKey": "", "ForcePathStyle": true, "AutoCreateBucket": false, "PartSizeMb": 8 },
        "AzureBlob": { "ConnectionString": "", "AutoCreateContainer": false }
      },
      "CloudPublic": {
        "Provider": "FileSystem",
        "RootPath": "",
        "DefaultContainer": "public",
        "S3": { "ServiceUrl": "", "Region": "us-east-1", "AccessKey": "", "SecretKey": "", "ForcePathStyle": true, "AutoCreateBucket": false, "PartSizeMb": 8 },
        "AzureBlob": { "ConnectionString": "", "AutoCreateContainer": false }
      }
    },
    // 業務分流：分類決定儲存目標、允許副檔名、大小上限、是否加密與是否僅供檢視（用戶端無法自行指定）
    "Categories": {
      "General": { "Target": "LocalPrivate" },
      // 正式報告 PDF（RPT 模組）：地端機密、僅 PDF、加密儲存，禁止經通用 api/v1/files 存取（須經報告授權）
      "Report": {
        "Target": "LocalPrivate",
        "Container": "reports",
        "AllowedExtensions": [ ".pdf" ],
        "MaxFileSizeBytes": 52428800,
        "AllowGenericApi": false, // false = 不允許經通用端點 api/v1/files 存取
        "Encrypt": true,
        "CacheMaxAgeSeconds": 0 // 不快取
      },
      // 公開圖片：不加密才能以預簽名網址 / CDN 直連（物件儲存驅動時）
      "Image": {
        "Target": "CloudPublic",
        "Container": "images",
        "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".gif", ".webp" ],
        "MaxFileSizeBytes": 20971520,
        "Encrypt": false,
        "CacheMaxAgeSeconds": 31536000
      }
    },
    "Image": {
      "ReencodeOnUpload": true, // 二次解碼重新編碼：洗除 Polyglot 夾帶代碼與 EXIF / GPS
      "MaxDimension": 12000,
      "MaxPixels": 80000000,
      "MaxFrames": 200,
      "JpegQuality": 85,
      "AllowedSizes": [ "64x64", "128x128", "256x256", "512x512", "1024x1024", "256x0", "512x0", "1024x0" ] // 縮圖尺寸白名單（防 DoS）
    },
    "ThumbnailCache": {
      "Enabled": true, // 各節點記憶體快取（不寫入本機磁碟）
      "MaxMemoryBytes": 268435456, // 256MB
      "SlidingExpirationMinutes": 60
    },
    "Watermark": {
      "Dpi": 120, // PDF 逐頁點陣化解析度
      "MaxPages": 50, // 單次線上檢視最多頁數（防 DoS）
      "Opacity": 60, // 浮水印不透明度（0~255）
      "JpegQuality": 80,
      "FontPath": "" // 空白時使用系統字型（Noto Sans TC → 微軟正黑體）
    },
    "Purge": {
      "RetentionDays": 30, // 虛擬刪除後保留天數，期滿由排程 file-purge 清除實體檔案
      "BatchSize": 200,
      "MaxBatchesPerRun": 50
    }
  },
  "HmsSettings": {
    "SharedSecret": "", // 機密：由環境變數 HmsSettings__SharedSecret 或 claudesettings.json 注入

    "BaseUrl": "http://localhost:5216" // 指向您的本地 Mock Server 或模擬環境
  }
}
